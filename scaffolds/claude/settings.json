{
  "permissions": {
    "allow": ["Bash(python3 -m ruff check *)", "Bash(python3 -m unittest *)", "Bash(python3 -m coverage *)", "Bash(./run_all.sh)", "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)"],
    "deny": ["Bash(rm -rf /*)", "Bash(curl * | sh:*)", "Bash(wget * | sh:*)", "Bash(git push --force*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/claude-hooks/guardrail.sh \"$CLAUDE_TOOL_INPUT\"", "timeout": 10}
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {"type": "prompt", "prompt": "Rappel quality gates OT Watch avant de conclure : ruff clean, tests OK, couverture >= 80 %, aucun secret en dur, en-têtes sécurité serveur présents. Voir AGENTS.md."}
        ]
      }
    ]
  }
}
